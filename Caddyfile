# Global Souin cache defaults (in-memory storage)
{
	cache {
		log_level warn
		default_cache_control public
	}
}

# ── Existing sites (unchanged) ──
:8120 {
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
		X-XSS-Protection "1; mode=block"
		Referrer-Policy no-referrer-when-downgrade
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	encode zstd gzip

	handle_path /thumbnails/* {
		root * C:/thumbnails
		header {
			Access-Control-Allow-Origin "*"
			Cross-Origin-Resource-Policy "cross-origin"
			Cache-Control "public, max-age=2592000"
		}
		file_server
	}

	@nocache path /raw/* /api/* /admin/* /player/*
	route @nocache {
		reverse_proxy localhost:7004
	}

	@cacheable {
		not path /raw/* /api/* /admin/* /player/*
	}
	route @cacheable {
		cache {
			ttl 2m
			stale 30s
		}
		reverse_proxy localhost:7004
	}
}

:8121 {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
		X-XSS-Protection "1; mode=block"
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	handle_path /videos/* {
		root * C:/Users/User/Desktop/hentai_videos
		header {
			Access-Control-Allow-Origin "*"
			Cross-Origin-Resource-Policy "cross-origin"
			X-Robots-Tag "noindex, nofollow"
			Cache-Control "public, max-age=604800"
		}
		file_server
	}

	handle_path /thumbnails/* {
		root * C:/thumbnails
		header {
			Access-Control-Allow-Origin "*"
			Cross-Origin-Resource-Policy "cross-origin"
			Cache-Control "public, max-age=2592000"
		}
		file_server
	}

	handle_path /previews/* {
		root * C:/Users/User/Desktop/hentai_previews
		header {
			Access-Control-Allow-Origin "*"
			Cross-Origin-Resource-Policy "cross-origin"
			Cache-Control "public, max-age=2592000"
		}
		file_server
	}

	# FIXED: Added proper slashes to matchers
	@nocache path /admin* /api/* /chat* /t/* /tx/* /img*
	route @nocache {
		reverse_proxy localhost:7007
	}

	# FIXED: Ensured every path starts with / and ends with /*
	@cacheable {
		not path /videos/* /thumbnails/* /previews/* /admin* /api* /chat* /t/* /img*
	}
	route @cacheable {
		cache {
			ttl 1m
			stale 30s
		}
		reverse_proxy localhost:7121
	}

	@static path *.css *.js *.png *.jpg *.jpeg *.gif *.ico *.svg *.webp
	header @static Cache-Control "public, max-age=604800, must-revalidate"
}

