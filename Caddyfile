# ── NEW: wps-transformer-player (CACHE EXTERNAL VIDEOS) ──
:8124 {
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
		X-XSS-Protection "1; mode=block"
		Referrer-Policy strict-origin-when-cross-origin
		X-Robots-Tag "noindex, nofollow"
		-Server
	}

	encode zstd gzip

	# Cache external video streams (/t/token → external CDN)
	@video_stream path /t/*
	route @video_stream {
		cache {
			ttl 7d
			stale 30s
		}
		reverse_proxy localhost:7200
	}

	# Cache local video files (/videos/:id → local MP4)
	@local_video path /videos/*
	route @local_video {
		cache {
			ttl 7d
			stale 30s
		}
		reverse_proxy localhost:7200
	}

	# Don't cache admin / API / thumbnails / preview clips
	@nocache path /api/* /admin* /img/* /previews/*
	route @nocache {
		reverse_proxy localhost:7200
	}

	# Cache everything else (HTML pages)
	@cacheable {
		not path /t/* /videos/* /api/* /admin* /img/* /previews/*
	}
	route @cacheable {
		cache {
			ttl 5m
			stale 30s
		}
		reverse_proxy localhost:7200
	}
}