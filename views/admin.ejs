<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Admin — <%= siteName %></title>
<meta name="robots" content="noindex, nofollow">
<link rel="stylesheet" href="/css/style.css">
</head>
<body>
<header class="topbar">
  <div class="container topbar-inner">
    <a href="/" class="brand">WPS<span>Transformer</span> Player</a>
    <nav>
      <a href="/">View site</a>
    </nav>
  </div>
</header>

<main class="admin-wrap">
  <h1 style="margin:0 0 20px">Admin</h1>

  <div class="admin-card">
    <h3>Stats</h3>
    <div class="stat-grid" id="statGrid"></div>
    <div class="origin-health">
      <h4>Origin health</h4>
      <div id="originList"><div class="origin-row muted">Loading…</div></div>
    </div>
  </div>

  <div class="admin-card">
    <h3>Feed URLs — paste a list</h3>
    <p style="font-size:13px;color:var(--wps-muted);margin:0 0 8px">
      One per line, or JSON. Supports <code>Title | https://url</code>, a bare URL, or a full <code>&lt;iframe src=...&gt;&lt;/iframe&gt;</code> embed. Lines starting with <code>#</code> are ignored.
    </p>
    <label for="ingestText">URL list</label>
    <textarea id="ingestText" class="admin-input" placeholder="# comment
My Video | https://example.com/video-page
https://another-site.com/embed/xyz
<iframe src='https://tube.com/xembed.php?video=abc'></iframe>"></textarea>
    <div style="margin-top:14px;display:flex;gap:10px;flex-wrap:wrap;align-items:center">
      <button class="btn" id="ingestBtn">Import</button>
      <label class="btn ghost file-upload">Upload file<input type="file" id="ingestFile" accept=".txt,.json,text/plain,application/json"></label>
      <button class="btn ghost" id="scanBtn">Scan data/imports folder</button>
    </div>
    <pre class="ingest-report" id="ingestReport"></pre>
  </div>

  <div class="admin-card">
    <h3>Library (<%= total %>)</h3>
    <div style="margin:0 0 10px;display:flex;gap:10px;align-items:center">
      <button class="btn ghost danger" id="bulkDeleteBtn" disabled>Delete selected (<span id="selCount">0</span>)</button>
    </div>
    <table class="admin-table">
      <thead><tr><th><input type="checkbox" id="checkAll" title="Select all"></th><th>Title</th><th>Source</th><th>Duration</th><th>Views</th><th>Actions</th></tr></thead>
      <tbody>
        <%- include('_rows') %>
      </tbody>
    </table>
  </div>
</main>

<script>
(function(){
  function report(msg, cls) {
    var el = document.getElementById('ingestReport');
    el.textContent = msg;
    el.className = 'ingest-report' + (cls ? ' ' + cls : '');
  }

  document.getElementById('ingestBtn').addEventListener('click', function(){
    var text = document.getElementById('ingestText').value;
    if (!text.trim()) return report('Paste something first.');
    var btn = this; btn.disabled = true; btn.textContent = 'Importing...';
    fetch('/api/ingest', {
      method: 'POST',
      headers: { 'Content-Type': 'text/plain' },
      body: text
    }).then(function(r){ return r.json(); }).then(function(d){
      btn.disabled = false; btn.textContent = 'Import';
      if (!d.ok) return report('ERROR: ' + (d.error || 'unknown'));
      var errs = (d.errors || []).map(function(e){ return '  x ' + (e.url || e.file || '?') + ' — ' + (e.error || 'fail'); });
      var out = 'total: ' + d.total + '\nadded: ' + d.added + '\nskipped (dupes): ' + d.skipped + '\nfailed: ' + d.failed;
      if (errs.length) out += '\n' + errs.join('\n');
      report(out, d.failed ? 'bad' : 'good');
      if (d.added) setTimeout(function(){ location.reload(); }, 1200);
    }).catch(function(e){ btn.disabled = false; btn.textContent = 'Import'; report('Network error: ' + e.message, 'bad'); });
  });

  var fileInput = document.getElementById('ingestFile');
  fileInput.addEventListener('change', function(){
    var f = fileInput.files[0];
    if (!f) return;
    var fr = new FileReader();
    fr.onload = function(){
      document.getElementById('ingestText').value = fr.result;
      document.getElementById('ingestBtn').click();
    };
    fr.readAsText(f);
  });

  document.getElementById('scanBtn').addEventListener('click', function(){
    var btn = this; btn.disabled = true;
    fetch('/api/ingest/scan', { method: 'POST' })
      .then(function(r){ return r.json(); })
      .then(function(d){
        btn.disabled = false;
        if (!d.ok) return report('ERROR: ' + d.error, 'bad');
        var r = d.report || {};
        report('files: ' + (d.files || 0) + '\nadded: ' + (r.added || 0) + '\nskipped: ' + (r.skipped || 0) + '\nfailed: ' + (r.failed || 0), r.failed ? 'bad' : 'good');
        if (r.added) setTimeout(function(){ location.reload(); }, 1200);
      }).catch(function(e){ btn.disabled = false; report('Network error: ' + e.message, 'bad'); });
  });

  // ── delete controls ──
  function selCheckboxes() { return Array.prototype.slice.call(document.querySelectorAll('.row-check')); }
  function selected() { return selCheckboxes().filter(function(c){ return c.checked; }); }

  function updateSel() {
    var n = selected().length;
    document.getElementById('selCount').textContent = n;
    document.getElementById('bulkDeleteBtn').disabled = n === 0;
    document.getElementById('checkAll').checked = n > 0 && n === selCheckboxes().length;
  }

  var checkAll = document.getElementById('checkAll');
  if (checkAll) {
    checkAll.addEventListener('change', function(){
      selCheckboxes().forEach(function(c){ c.checked = checkAll.checked; });
      updateSel();
    });
  }
  selCheckboxes().forEach(function(c){ c.addEventListener('change', updateSel); });

  function doDelete(ids, done) {
    var btn = document.getElementById('bulkDeleteBtn');
    var prev = btn.textContent;
    btn.disabled = true; btn.textContent = 'Deleting...';
    fetch('/api/videos/delete', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ ids: ids })
    }).then(function(r){ return r.json(); }).then(function(d){
      btn.textContent = prev;
      if (!d.ok) return report('ERROR: ' + (d.error || 'unknown'), 'bad');
      report('deleted: ' + d.deleted, 'good');
      done(d);
    }).catch(function(e){ btn.disabled = false; btn.textContent = prev; report('Network error: ' + e.message, 'bad'); });
  }

  document.getElementById('bulkDeleteBtn').addEventListener('click', function(){
    var ids = selected().map(function(c){ return c.value; });
    if (!ids.length) return;
    if (!confirm('Delete ' + ids.length + ' selected video(s)? This cannot be undone.')) return;
    doDelete(ids, function(){ location.reload(); });
  });

  document.querySelectorAll('.del-single').forEach(function(btn){
    btn.addEventListener('click', function(){
      var id = btn.getAttribute('data-id');
      if (!confirm('Delete "' + btn.getAttribute('data-title') + '"? This cannot be undone.')) return;
      doDelete([id], function(){ location.reload(); });
    });
  });

  // ── stats strip ──
  var grid = document.getElementById('statGrid');
  var originList = document.getElementById('originList');
  function chip(label, value) { return '<div class="stat-chip"><b>' + value + '</b><span>' + label + '</span></div>'; }
  function fmtBytes(n) {
    var u = ['B', 'KB', 'MB', 'GB'], i = 0;
    while (n >= 1024 && i < u.length - 1) { n /= 1024; i++; }
    return (n >= 10 ? Math.round(n) : n.toFixed(1)) + ' ' + u[i];
  }
  function render(d) {
    var l = d.library, w = d.window, live = d.live, disk = d.disk;
    var totalDisk = disk.thumbs + disk.previews + disk.sprites;
    grid.innerHTML =
      chip('Videos', l.total) +
      chip('Thumbs', l.thumbCached + '/' + l.thumbed) +
      chip('Viewers', live.inFlight) +
      chip('Req/min', (Math.round(w.reqPerMin * 10) / 10)) +
      chip('Disk', fmtBytes(totalDisk));
    originList.innerHTML = (d.origin && d.origin.length)
      ? d.origin.map(function(h){
          return '<div class="origin-row' + (h.errors ? ' bad' : '') + '"><b>' + h.host + '</b><span>' + h.requests + ' req · ' + h.errors + ' err' + (h.blocked ? ' · ' + h.blocked + ' blocked' : '') + '</span></div>';
        }).join('')
      : '<div class="origin-row muted">No origin requests yet.</div>';
  }
  function refresh() { fetch('/api/stats').then(function(r){ return r.json(); }).then(render).catch(function(){}); }
  refresh();
  setInterval(refresh, 10000);
})();
</script>
</body>
</html>
