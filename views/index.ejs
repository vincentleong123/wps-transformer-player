<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= siteName %></title>
    <meta name="description" content="Browse <%= total %> videos">
    <meta name="theme-color" content="#0f0f0f">
    <meta name="robots" content="noindex, nofollow">
    <link rel="stylesheet" href="/css/gallery.css">
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🎬</text></svg>">
</head>
<body>
    <!-- Scroll to Top Button -->
    <button class="scroll-top" aria-label="Scroll to top">
        <svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor">
            <path d="M7 14l5-5 5 5z"/>
        </svg>
    </button>

    <!-- Header -->
    <header class="header">
        <div class="header-content">
            <div class="logo">
                <a href="/">
                    <span class="logo-icon">▶</span>
                    <h1 class="site-logo"><%= siteName %></h1>
                </a>
            </div>

            <!-- Search Bar -->
            <div class="search-container">
                <div class="search-box">
                    <svg class="search-icon" viewBox="0 0 24 24" width="20" height="20" fill="currentColor">
                        <path d="M15.5 14h-.79l-.28-.27A6.471 6.471 0 0016 9.5 6.5 6.5 0 109.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/>
                    </svg>
                    <input type="search" class="search-input" id="searchInput" placeholder="Search videos..." autocomplete="off" aria-label="Search videos">
                    <button class="search-clear" id="searchClear" aria-label="Clear search" style="display:none">
                        <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
                            <path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/>
                        </svg>
                    </button>
                </div>
            </div>

            <!-- Header Actions -->
            <div class="header-actions">
                <span class="video-count"><%= total %> videos</span>
                <% if (isAdminPage) { %><a href="/admin" class="video-count" style="color:var(--accent-primary);font-weight:600">Admin</a><% } %>
            </div>
        </div>
    </header>

    <!-- Main Content -->
    <main class="container">
        <div class="content-wrapper">
            <div class="gallery-container" style="width:100%">
                <% if (!videos.length) { %>
                    <div style="text-align:center;color:var(--text-muted);padding:60px 20px">
                        <p>No videos yet. Drop a <code>list.txt</code> in <code>data/imports/</code> or paste links in the admin panel.</p>
                        <% if (isAdminPage) { %><p style="margin-top:12px"><a href="/admin" style="color:var(--accent-primary)">Go to Admin →</a></p><% } %>
                    </div>
                <% } else { %>
                <div class="video-grid" id="videoGrid" role="list" aria-label="Video gallery">
                    <% videos.forEach(function(v){ %>
                    <% var canPrev = v.video && (!v.type || v.type !== 'hls'); %>
                    <article class="video-card" data-search="<%= v.title.toLowerCase() %> <%= (v.tags||[]).join(' ').toLowerCase() %> <%= v.category.toLowerCase() %>" data-src="<%= canPrev ? v.video : '' %>" role="listitem">
                        <a href="/watch/<%= v.id %>" class="video-link">
                            <div class="thumbnail-container">
                                <% if (v.thumbnail) { %>
                                <img src="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 320 180'%3E%3Crect fill='%23222' width='320' height='180'/%3E%3C/svg%3E"
                                     data-src="<%= v.thumbnail %>"
                                     alt="<%= v.title %>"
                                     class="thumbnail lazy-load" width="320" height="180" loading="lazy">
                                <% } %>
                                <% if (canPrev) { %><video class="hover-preview" preload="none" muted playsinline></video><% } %>
                                <div class="play-overlay">
                                    <svg viewBox="0 0 24 24" width="32" height="32" fill="currentColor">
                                        <path d="M8 5v14l11-7z"/>
                                    </svg>
                                </div>
                                <span class="duration-badge"><%= v.duration || 'HD' %></span>
                            </div>
                            <div class="video-info">
                                <h3 class="video-title"><%= v.title %></h3>
                                <div class="video-meta">
                                    <span class="view-count"><%= v.views %> views</span>
                                    <% if (v.external) { %><span style="color:var(--accent-secondary);font-size:11px">hotlink</span><% } %>
                                </div>
                            </div>
                        </a>
                    </article>
                    <% }); %>
                </div>
                <% } %>
            </div>
        </div>
    </main>

    <%- include('footer-component') %>

    <script>
    (function(){
        // Search filter
        var input = document.getElementById('searchInput');
        var clear = document.getElementById('searchClear');
        var cards = Array.prototype.slice.call(document.querySelectorAll('.video-card'));
        var grid = document.getElementById('videoGrid');

        function apply(){
            var q = input.value.trim().toLowerCase();
            var shown = 0;
            cards.forEach(function(c){
                var ok = !q || (c.getAttribute('data-search') || '').indexOf(q) !== -1;
                c.style.display = ok ? '' : 'none';
                if (ok) shown++;
            });
            clear.style.display = q ? 'block' : 'none';
        }
        if (input) input.addEventListener('input', apply);
        if (clear) clear.addEventListener('click', function(){ input.value=''; apply(); input.focus(); });

        // Lazy load thumbnails
        var lazy = document.querySelectorAll('.lazy-load');
        if ('IntersectionObserver' in window) {
            var obs = new IntersectionObserver(function(entries){
                entries.forEach(function(en){
                    if (en.isIntersecting) {
                        var img = en.target;
                        img.src = img.dataset.src;
                        img.classList.add('loaded');
                        img.classList.remove('lazy-load');
                        obs.unobserve(img);
                    }
                });
            }, { rootMargin: '200px' });
            lazy.forEach(function(img){ obs.observe(img); });
        } else {
            lazy.forEach(function(img){ img.src = img.dataset.src; img.classList.add('loaded'); });
        }

        // Scroll to top
        var sb = document.querySelector('.scroll-top');
        if (sb) {
            window.addEventListener('scroll', function(){
                sb.classList.toggle('visible', window.pageYOffset > 300);
            });
            sb.addEventListener('click', function(){ window.scrollTo({ top: 0, behavior: 'smooth' }); });
        }

        // ── Hover preview: 10 chopped chunks, END → START ────────────────────
        var previews = [];
        document.querySelectorAll('.video-card[data-src]').forEach(function(card){
            var v = card.querySelector('.hover-preview');
            if (!v) return;
            previews.push({ card: card, v: v });
        });

        if (previews.length && ('HTMLVideoElement' in window)) {
            var SEG_MS = 500; // play ~0.5s per chunk
            var active = null;
            var tmr = null;

            function buildTimes(d){
                var times = [];
                for (var i = 0; i < 10; i++) {
                    var r = 0.95 - i * (0.9 / 9); // 95% → 5%, end to start
                    times.push(Math.max(0, d * r));
                }
                return times;
            }

            function nextSeg(){
                var a = active; if (!a) return;
                a.idx = (a.idx + 1) % a.times.length;
                a.segStart = a.times[a.idx];
                a.v.currentTime = a.segStart;
                var p = a.v.play();
                if (p && p.catch) p.catch(function(){});
                if (tmr) clearTimeout(tmr);
                tmr = setTimeout(nextSeg, 2500); // stall safety
            }

            function start(card){
                stop();
                var v = card.querySelector('.hover-preview');
                if (!v) return;
                active = { v: v, times: [], idx: 0, segStart: 0 };
                v.muted = true;
                v.setAttribute('src', card.getAttribute('data-src'));
                v.load();
                v.ontimeupdate = function(){
                    var a = active;
                    if (!a || a.v !== v) return;
                    if (a.times.length && v.currentTime - a.segStart >= 0.45) nextSeg();
                };
                v.onloadedmetadata = function(){
                    var a = active; if (!a || a.v !== v) return;
                    var d = v.duration;
                    if (!isFinite(d) || d <= 0) return;
                    a.times = buildTimes(d);
                    a.segStart = a.times[0];
                    v.currentTime = a.segStart;
                    var p = v.play();
                    if (p && p.catch) p.catch(function(){});
                    if (tmr) clearTimeout(tmr);
                    tmr = setTimeout(nextSeg, 2500);
                };
            }

            function stop(){
                if (tmr) { clearTimeout(tmr); tmr = null; }
                var a = active; active = null;
                if (!a) return;
                var v = a.v;
                v.onloadedmetadata = null;
                v.ontimeupdate = null;
                v.pause();
                v.removeAttribute('src');
                v.load();
            }

            previews.forEach(function(p){
                p.card.addEventListener('mouseenter', function(){ start(p.card); });
                p.card.addEventListener('mouseleave', stop);
                p.card.addEventListener('touchstart', function(){ start(p.card); }, { passive: true });
                p.card.addEventListener('touchend', stop);
                p.card.addEventListener('touchcancel', stop);
            });

            // Warm metadata for on-screen cards so hover starts instantly
            var prevs = previews;
            if ('IntersectionObserver' in window) {
                var wob = new IntersectionObserver(function(entries){
                    entries.forEach(function(en){
                        if (en.isIntersecting) {
                            var card = en.target;
                            var v = card.querySelector('.hover-preview');
                            if (v && v.preload !== 'metadata') { v.preload = 'metadata'; v.load(); }
                            wob.unobserve(card);
                        }
                    });
                }, { rootMargin: '300px' });
                previews.forEach(function(p){ wob.observe(p.card); });
            }
        }
    })();
    </script>
</body>
</html>
